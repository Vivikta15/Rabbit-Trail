{
  "name": "rabbit-trail",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup:key": "tsc -p tsconfig.lib.json && node --env-file-if-exists=.env.local dist/scripts/setup-key.js",
    "setup:gemini": "tsc -p tsconfig.lib.json && node --env-file-if-exists=.env.local dist/scripts/setup-key.js --provider gemini",
    "setup:supabase":"tsc -p tsconfig.lib.json && node --env-file-if-exists=.env.local dist/scripts/setup-supabase.js",
    "social:post": "tsc -p tsconfig.lib.json && node --env-file-if-exists=.env.local dist/scripts/post-social.js",
    "stats": "tsc -p tsconfig.lib.json && node --env-file-if-exists=.env.local dist/scripts/stats.js",
    "doctor":"tsc -p tsconfig.lib.json && node --env-file-if-exists=.env.local dist/scripts/doctor.js",
    "stories:generate": "tsc -p tsconfig.lib.json && node --env-file-if-exists=.env.local dist/scripts/generate-stories.js",
    "db:import": "tsc -p tsconfig.lib.json && node --env-file-if-exists=.env.local dist/scripts/import-stories.js",
    "pretest": "tsc -p tsconfig.lib.json",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.5.4"
  }
}
