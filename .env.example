# Copy the settings you need into a file named .env.local (gitignored). Easiest for the AI key:
#   npm run setup:gemini     (Google Gemini)   or   npm run setup:key     (Anthropic Claude)
# Never put a real key in this example file.

# ---- Needed to GENERATE stories (your computer, or the GitHub Action) --------------------------------------------
# Choose ONE AI service. The website itself does not need an AI key.
# Which one writes stories: "gemini" or "anthropic". The setup commands set this for you. Needed only if both keys
# below are set; with just one key it is chosen automatically.
LLM_PROVIDER=

# Google Gemini. Get a key at aistudio.google.com/apikey.
GEMINI_API_KEY=
# Optional: the Gemini model (default gemini-3.8-flash). A comma-separated list is tried in order: when the first
# is busy or out of its free daily allowance the next one is used, so a day's story is not lost.
# GEMINI_MODEL=gemini-3.6-flash,gemini-3.8-flash

# Anthropic Claude. Starts with sk-ant-. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional: the Claude model (default claude-sonnet-5-5).
# STORY_MODEL=claude-sonnet-5-5

# ---- Where stories are kept -------------------------------------------------------------------------------------
# Leave both Supabase settings empty to keep stories as files in content/stories (development only).
# The deployed website MUST have both set. Set both or neither: one without the other is an error.
# Supabase dashboard -> Project Settings -> API. The URL looks like https://abcdefghij.supabase.co
SUPABASE_URL=
# The SECRET key (starts with sb_secret_; older projects: the long "service_role" key). Never the public key.
# It can read and write everything, so it must only ever live on the server (Vercel / GitHub secrets / .env.local).
SUPABASE_SERVICE_ROLE_KEY=

# ---- Reader accounts (optional: sign-in with Google or an email link) ---------------------------------------------
# The PUBLIC key from the same page (starts with sb_publishable_). It is sent to browsers on purpose, so it must
# never be the secret key: the app refuses a secret key here. Leave empty to keep sign-in switched off.
SUPABASE_PUBLISHABLE_KEY=
# Optional: set to 1 to show the "Continue with Google" button. Only after Google is set up in Supabase.
# GOOGLE_SIGNIN_ENABLED=

# Optional: folder for local story files (default content/stories). Ignored when Supabase is set.
# STORIES_DIR=

# Optional: set to 1 to make a run refuse to use local files (the daily GitHub workflow does this).
# REQUIRE_SUPABASE=
# Optional: a second, lighter model that only checks each draft (so the writer does not grade its own work).
# Each Gemini model has its own daily allowance, so this also spreads the free-tier limit.
# GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite
