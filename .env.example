# Copy the settings you need into a file named .env.local (gitignored). Easiest for the key:
#   npm run setup:key
# Never put a real key in this example file.

# Required for generating stories. Starts with sk-ant-. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Optional: the Claude model used to write and check stories (default claude-sonnet-5-5).
# STORY_MODEL=claude-sonnet-5-5

# Optional: where story files are kept (default content/stories in this project).
# STORIES_DIR=
