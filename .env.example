# Copy the settings you need into a file named .env.local (gitignored). Easiest for the Anthropic key:
#   npm run setup:key
# Never put a real key in this example file.

# ---- Needed to GENERATE stories (your computer, or the GitHub Action) --------------------------------------------
# Starts with sk-ant-. Get one at console.anthropic.com. The website itself does not need this.
ANTHROPIC_API_KEY=

# Optional: the Claude model used to write and check stories (default claude-sonnet-5-5).
# STORY_MODEL=claude-sonnet-5-5

# ---- Where stories are kept -------------------------------------------------------------------------------------
# Leave both Supabase settings empty to keep stories as files in content/stories (development only).
# The deployed website MUST have both set. Set both or neither: one without the other is an error.
# Supabase dashboard -> Project Settings -> API. The URL looks like https://abcdefghij.supabase.co
SUPABASE_URL=
# The SECRET key (starts with sb_secret_; older projects: the long "service_role" key). Never the public key.
# It can read and write everything, so it must only ever live on the server (Vercel / GitHub secrets / .env.local).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: folder for local story files (default content/stories). Ignored when Supabase is set.
# STORIES_DIR=

# Optional: set to 1 to make a run refuse to use local files (the daily GitHub workflow does this).
# REQUIRE_SUPABASE=
